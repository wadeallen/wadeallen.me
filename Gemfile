source 'https://rubygems.org'

# Match the versions GitHub Pages uses to build the site
gem "github-pages", group: :jekyll_plugins

# Needed for "bundle exec jekyll serve" on newer versions of Ruby
gem "webrick"

# Keep compatible with Ruby 2.7 on Wade's Mac (newer ffi needs Ruby 3+)
gem "ffi", "~> 1.16.3"
